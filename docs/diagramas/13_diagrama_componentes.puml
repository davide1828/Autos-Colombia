@startuml diagrama_componentes_iteraciones_1_2_3
skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle uml2
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #64748B
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor #0F4C81
skinparam interfaceBorderColor #0F4C81

title Componentes — Autos Colombia (Iteraciones 1, 2 y 3)

package "Frontend PWA (React + Vite)" {
  [Operación: ingreso, salida y patio] as UIOperacion
  [Administración: usuarios, celdas,\nclientes y vehículos] as UIGestion
  [Gestión de pagos e historial] as UIPagos
  [Cliente API HTTP / sesión] as APIClient
  UIOperacion ..> APIClient
  UIGestion ..> APIClient
  UIPagos ..> APIClient
}

cloud "HTTP / HTTPS · JSON" as HTTP
APIClient -- HTTP

package "Backend Go · arquitectura hexagonal" {
  package "Adaptadores primarios" {
    [Router y middleware\nsesión/RBAC] as Router
    [Handlers de operación] as HOperacion
    [Handlers de gestión] as HGestion
    [Handlers de pago] as HPago
    HTTP -- Router
    Router --> HOperacion
    Router --> HGestion
    Router --> HPago
  }

  package "Aplicación" {
    interface "ServicioOperaciones" as IOperacion
    interface "ServicioGestion" as IGestion
    interface "ServicioPago" as IPago
    [Casos de uso ingreso/salida] as SOperacion
    [Casos de uso usuarios,\nclientes, vehículos y celdas] as SGestion
    [Casos de uso de pagos,\nhistorial y recibos] as SPago
    IOperacion - SOperacion
    IGestion - SGestion
    IPago - SPago
    HOperacion ..> IOperacion
    HGestion ..> IGestion
    HPago ..> IPago
  }

  package "Dominio" {
    [Reglas de operación\ny vigencia mensual] as DOperacion
    [Entidades de gestión] as DGestion
    [Pago, mensualidad y recibo\ninterno SHA-256] as DPago
    SOperacion ..> DOperacion
    SGestion ..> DGestion
    SPago ..> DPago
    DPago ..> DOperacion : vigencia
  }

  package "Adaptadores secundarios" {
    interface "RepositorioOperaciones" as ROperacion
    interface "RepositorioGestion" as RGestion
    interface "RepositorioPago" as RPago
    [PostgreSQL] as RepoPG
    [Memoria para pruebas] as RepoMem
    ROperacion - RepoPG
    RGestion - RepoPG
    RPago - RepoPG
    ROperacion -- RepoMem
    RGestion -- RepoMem
    RPago -- RepoMem
    SOperacion ..> ROperacion
    SGestion ..> RGestion
    SPago ..> RPago
  }
}

database "PostgreSQL 16" {
  [Operación: vehículo, celda,\nregistro y novedad] as TablasOp
  [Gestión: usuario, cliente,\nauditoría y mensualidad] as TablasGestion
  [Pagos: pago, mensualidad\nvinculada, sello SHA-256] as TablaPago
  [Índice único parcial:\nun pago PAGADO por cliente/mes] as ReglaDuplicado
  RepoPG --> TablasOp
  RepoPG --> TablasGestion
  RepoPG --> TablaPago
  TablaPago ..> ReglaDuplicado
}
@enduml
